<Window x:Class="PorteiroVision.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vision"
        Height="720" Width="1000"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#0A1222"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Estilo dos Botões Primários -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de Ação Start/Stop -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="24,14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/> <!-- Barra de Título Customizada -->
                <RowDefinition Height="Auto"/> <!-- Hero / Botão Principal -->
                <RowDefinition Height="Auto"/> <!-- Links e Telemetria -->
                <RowDefinition Height="*"/>    <!-- Câmeras e Logs -->
                <RowDefinition Height="38"/>   <!-- Rodapé -->
            </Grid.RowDefinitions>

            <!-- 1. BARRA DE TÍTULO -->
            <Grid Grid.Row="0" Background="#070D18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="👁️" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="VISION" FontWeight="Bold" FontSize="15" Foreground="#3DD6F5" VerticalAlignment="Center"/>
                    <Border Background="#111C33" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v3.0" FontSize="11" FontWeight="Bold" Foreground="#9FB0C8"/>
                    </Border>
                </StackPanel>

                <!-- Status Badge no Topo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border x:Name="TopStatusBadge" Background="#1E293B" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="TopStatusDot" Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TopStatusText" Text="HUB DESLIGADO" FontSize="12" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Botões de Janela -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="46" Height="44" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Content="—" FontSize="14" Cursor="Hand" Click="MinimizeBtn_Click"/>
                    <Button Width="46" Height="44" Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            Content="✕" FontSize="14" Cursor="Hand" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. HERO SECTION / START STOP -->
            <Border Grid.Row="1" Background="#111827" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Central de Streaming e Monitoramento Inteligente" FontSize="18" FontWeight="Bold" Foreground="#F1F5F9"/>
                        <TextBlock x:Name="HubSubtitle" Text="O servidor local está pronto para ser iniciado. Clique no botão ao lado para ligar as câmeras."
                                   FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button x:Name="MainActionBtn" Grid.Column="1" Style="{StaticResource ActionBtn}"
                            Background="#10B981" Content="▶ INICIAR HUB DE CÂMERAS" Click="MainActionBtn_Click"/>
                </Grid>
            </Border>

            <!-- 3. CARDS DE CONEXÃO & TELEMETRIA -->
            <Grid Grid.Row="2" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- LINKS DE CONEXÃO -->
                <Border Grid.Column="0" Background="#111827" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="🌐 LINKS DE ACESSO" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                        <!-- Local -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🏠 Este PC:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LocalUrlText" Grid.Column="1" Text="http://127.0.0.1:8090" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Style="{StaticResource ModernBtn}" Content="Abrir" Margin="0,0,6,0" Click="OpenLocalBrowser_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="Copiar" Click="CopyLocalUrl_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Tablet / Celular -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="📱 Tablet/Wi-Fi:" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock x:Name="WifiUrlText" Grid.Column="1" Text="http://192.168.4.127:8090" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Style="{StaticResource ModernBtn}" Content="Copiar" Click="CopyWifiUrl_Click"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- TELEMETRIA DO SISTEMA -->
                <Border Grid.Column="1" Background="#111827" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="⚡ TELEMETRIA EM TEMPO REAL" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>

                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,0,4,4">
                                <StackPanel>
                                    <TextBlock Text="Câmeras Ativas" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="ActiveCamsText" Text="0 Online" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="4,0,0,4">
                                <StackPanel>
                                    <TextBlock Text="CPU do App" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="CpuText" Text="-- %" FontSize="15" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="0,4,4,0">
                                <StackPanel>
                                    <TextBlock Text="RAM do App" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="RamText" Text="-- MB" FontSize="15" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#1E293B" CornerRadius="8" Padding="10,8" Margin="4,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="Vídeo Câmeras" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="NetText" Text="-- KB/s" FontSize="15" FontWeight="Bold" Foreground="#A855F7" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. LISTA DE CÂMERAS & LOGS AO VIVO -->
            <Grid Grid.Row="3" Margin="16,8,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LISTA DE CÂMERAS -->
                <Border Grid.Column="0" Background="#111827" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="📹 CÂMERAS MONITORADAS" FontSize="12" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CamerasPanel">
                                <!-- Cards inseridos dinamicamente pelo código -->
                                <TextBlock Text="Inicie o Hub para carregar o status das câmeras." Foreground="#64748B" FontStyle="Italic" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- LOGS AO VIVO DO SERVIDOR -->
                <Border Grid.Column="1" Background="#0A0E17" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="12" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="🖥️ LOGS DO SISTEMA" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ModernBtn}" Padding="8,4" FontSize="11" Content="Limpar" Click="ClearLogs_Click"/>
                        </Grid>

                        <ScrollViewer x:Name="LogScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogsTextBox" Background="Transparent" Foreground="#A7F3D0" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" IsReadOnly="True" IsUndoEnabled="False"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 5. RODAPÉ DE CONFIGURAÇÕES -->
            <Border Grid.Row="4" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="MinimizeToTrayCheck" Content="Minimizar para a bandeja ao fechar (X)" Foreground="#CBD5E1"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Iniciar com o Windows" Foreground="#CBD5E1"
                                  VerticalAlignment="Center" Click="StartWithWindowsCheck_Click" Margin="0,0,16,0"/>
                        <CheckBox x:Name="DesktopNotificationsCheck" Content="Notificações Windows (Toast)" Foreground="#CBD5E1"
                                  IsChecked="True" VerticalAlignment="Center" Click="DesktopNotificationsCheck_Click" Margin="0,0,14,0"/>
                        <Button Style="{StaticResource ModernBtn}" Content="🔔 Testar Toast" Padding="8,3" FontSize="11" Click="TestToast_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="FooterStatus" HorizontalAlignment="Right" Text="Pronto." Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
